{
  "description": "Extra parity cases for BL-0019: units, prefixes, number forms and complex literals that grader_vectors.json does not reach. Both graders must agree on every one. Left out on purpose: inputs on which the reference raises instead of returning a grade ('()' gives a TypeError in parse_complex), results that are infinite (JSON cannot hold them), and pint units outside the port's table (dB, degC, inch, foot and the like).",
  "sections": [
    {
      "name": "units:volt",
      "spec": { "kind": "numeric", "unit": "V", "tolerance": { "rel": 1e-9 }, "bare_number_means": "V" },
      "reference": 1.0,
      "inputs": [
        "1 V", "1000 mV", "0.001 kV", "1000000 uV", "1000000 µV", "1000000 μV", "1e6 uV", "1 volt", "1 volts",
        "1000 millivolt", "0.001 kilovolt", "1e-6 MV", "1e-3 kV", "1 V*A/A", "1 V**1", "2 V**2/V", "1 V/1",
        "1", "1.", ".1e1", "+1", "-1 V", "1e0 V", "1E0 V", "  1   V  ", "1,0 V", "1,0", "1 mv", "1 Mv", "1 foo",
        "1 A", "1 V*A", "1 V/A", "1 s", "1 m", "1 V^2", "1 V**2", "1 V**-1", "1 V**", "1 V*", "1 *V", "1 /V",
        "1 V/", "1 V.A", "1 V-A", "1 V**2**0", "1 V**+1", "1 3", "1 2 V", "1 V*2", "1 2*V", "1 V/2", "1 (V)",
        "1 V!", "1 V,", "1,000 V", "1,0,0 V", "1.0,0 V", "1 V V", "1 V s/s", "V", "1 1", "1 dimensionless",
        "abcdefghijklmnopqrstuvwxyz", "1 abcdefghijklmnopqrstuv", "1 abcdefghijklmnopqrstuvw",
        "1 V*A*s/A/s/s*s*A/A/A/A"
      ]
    },
    {
      "name": "units:ohm",
      "spec": { "kind": "numeric", "unit": "ohm", "tolerance": { "rel": 0.01, "abs": 0.001 }, "bare_number_means": "ohm" },
      "reference": 1000.0,
      "wrong": [
        { "tag": "mc.parallel-instead-of-series", "value": 500.0, "feedback_md": "That is the parallel value." },
        { "tag": "mc.no-feedback", "value": 2000.0 }
      ],
      "inputs": [
        "1 kohm", "1 kΩ", "1 kOhm", "1 kOhms", "1 kilohm", "1000 ohm", "1000 Ω", "1000 Ohm", "1000 ohms",
        "0.001 Mohm", "1e-3 MΩ", "1000", "1 V/mA", "1000 V/A", "500 ohm", "500", "2 kohm", "0.5 kohm",
        "1.01 kohm", "1.011 kohm", "990 ohm", "989 ohm", "1 Gohm", "1 mohm", "1 uohm", "1 µΩ", "1 A", "1 S",
        "5 ohm*A", "1 k ohm", "1 k", "1 e", "1 kohmx", "1 ohmx"
      ]
    },
    {
      "name": "units:time",
      "spec": { "kind": "numeric", "unit": "s", "tolerance": { "rel": 1e-9 } },
      "reference": 60.0,
      "inputs": [
        "60 s", "1 min", "1 minute", "1 mins", "1 minutes", "60000 ms", "0.001 ks", "0.016666666666666666 h",
        "1 hr", "1 h", "3600 s", "1 d", "60", "60 Hz", "60 1/Hz", "60 Hz**-1", "6e7 us", "6e10 ns", "1 sec",

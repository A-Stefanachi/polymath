        "3%2", "3//2", "3,2", "3;2", "abc", "j(2)", "2(3)", "3(j)", "(3)(2)", "__import__('os')", "3-2j\n",
        "2**2-2*2-3j*0+3-2j", "(1+j)**2", "(1-j)**2", "j**2", "j**3", "j**-1", "2**-1", "2**0.5", "(-8)**0.5",
        "(-8)**2", "(-8)**-2", "(-8)**3", "0**0", "0**1", "0**-1", "0j**0", "0j**2", "0j**-1", "0**0.5", "0**j",
        "2**j", "j**j", "(1+j)**0.5", "(1+j)**(1+j)", "10**64", "10**65", "10**-64", "10**-65", "9**64", "9**65",
        "2**64", "2**65", "1e300**1", "1e200**2","(3-2j)**1", "(3-2j)**0", "(3-2j)**-1",

        "2**2**2", "2**2**3", "2**-2**2", "(2**2)**2", "-2**-2", "007", "00", "0", "0.0", "0e0", "0j", "09.5",
        "09.5-2j", "00.5", "0.5.5", "5.5.5", "1e5j", "1e-5j", "1E5", "1E5j", "1.5E+2", "1.5e+2j"
      ]
    },
    {
      "name": "complex:wrong-answers",
      "spec": { "kind": "complex", "tolerance": { "abs": 0.01, "rel": 0.01 } },
      "reference": [0.0, 2.0],
      "wrong": [
        { "tag": "mc.sign", "value": [0.0, -2.0], "feedback_md": "Check the sign." },
        { "tag": "mc.real-only", "value": 2.0 }
      ],
      "inputs": ["2j", "-2j", "2", "0+2j", "1e-3+2j", "-4**0.5", "(-4)**0.5", "4**0.5", "2.02j", "2.03j", "j*2"]

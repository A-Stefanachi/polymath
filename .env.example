# Every variable of doc 03 section 9.1, names only (BL-0005). Values live in each platform's
# secret store (doc 03 section 9.2) and in an untracked .env; never commit a value here.
# "Secret" marks the ones that must never reach a log, a fixture, the browser or the sandbox.

APP_ENV=local
# Set by CI; included in logs and /health.
GIT_SHA=

# Browser and web. Public by design: RLS and grants protect the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret. Server only (apps/web/src/server/privileged and the worker). Never NEXT_PUBLIC_, never
# in the sandbox.
SUPABASE_SECRET_KEY=
# Secret. Pooler URL for the web (transaction mode), direct URL for the worker.
DATABASE_URL_PRIVILEGED=

# Signup toggle (BL-0021, ST-AUTH-01): "true" lets an unknown email create an account on first
# sign-in; any other value, or unset, refuses new accounts. Keep it off on staging once the
# founder's account exists, in step with the dashboard setting "Allow new users to sign up".
AUTH_SIGNUP_ENABLED=

LLM_PROVIDER=fake
LLM_MODEL_STRONG=
LLM_MODEL_CHEAP=
# Secret. One key per environment, with a monthly limit set at OpenRouter (00a I1).
OPENROUTER_API_KEY=
LLM_DAILY_USER_BUDGET_USD=0.50
LLM_DAILY_GLOBAL_BUDGET_USD=5.00

WORKER_URL=
# Secret. Web to worker; rotate by accepting two secrets for 24 h.
WORKER_HMAC_SECRET=
# Secret. Worker to web callback; separate from WORKER_HMAC_SECRET.
INTERNAL_APPLY_HMAC_SECRET=

# Worker to sandbox, private network (for example http://polymath-sandbox.internal:8080).
SANDBOX_URL=
# nsjail on staging and production, docker locally. The sandbox's only variable.
SANDBOX_MODE=docker

# Web push. The private key is secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Low sensitivity.
SENTRY_DSN=

# Supabase Auth custom SMTP (SMTP_*) is set in the Supabase dashboard, not in this file.

{
  "name": "polymath",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @polymath/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint:boundaries": "node tools/boundaries/src/cli.ts",
    "claims:lint": "node tools/claims-lint/src/cli.ts",
    "db:start": "supabase start -x studio,edge-runtime,logflare,vector,imgproxy,supavisor,realtime,postgres-meta",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "db:diff-reference": "python3 -B tools/db/diff_reference.py",
    "test:db": "supabase test db",
    "gen:db-types": "node tools/gen/gen-types.mjs db",
    "gen:api-types": "node tools/gen/gen-types.mjs api"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "openapi-typescript": "7.13.0",
    "supabase": "2.121.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}

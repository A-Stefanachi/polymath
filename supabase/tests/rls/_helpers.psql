-- A shared (user_id null) verified item and, per learner, a verified own item with a secret.
insert into public.items (id, template_key, template_version, seed, params, rendered, verification_report, status, user_id)
  values ('0000a011-0000-4000-8000-0000000000f0', 'tpl.math.rlstest-t', 1, 1, '{"p":1}', '{"prompt":"x"}',
          '{"verifier":"v","agreed":true}', 'verified', null);
create function rls_test.seed_user(p_user uuid, p_tag text, p_n int) returns void language plpgsql as $$
declare
  v_item uuid := ('0000a011-0000-4000-8000-0000000000' || lpad(p_n::text, 2, '0'))::uuid;
  v_plan uuid; v_session uuid; v_up uuid; v_ch uuid; v_thread uuid; v_msg uuid;
begin
  insert into public.items (id, template_key, template_version, seed, params, rendered, verification_report, status, user_id)
    values (v_item, 'tpl.math.rlstest-t', 1, 100 + p_n, '{"p":1}', '{"prompt":"x"}', '{"verifier":"v","agreed":true,"key":42}', 'verified', p_user);
  insert into public.item_secrets (item_id, answer_key, hidden_tests) values (v_item, '{"a":42}', '{"t":1}');
  insert into public.attempts (user_id, item_id, started_at, submitted_at, response, grade, grade_status, client_attempt_id)
    values (p_user, v_item, now() - interval '1 min', now(), '{"v":1}',
            '{"status":"graded","score":1,"correct":true,"graders":[]}', 'graded', gen_random_uuid());
  insert into public.skill_state (user_id, skill_key) values (p_user, 'math.rlstest.pub');
  insert into public.review_log (user_id, skill_key, rating) values (p_user, 'math.rlstest.pub', 3);
  insert into public.weekly_plans (user_id, week_start, target_minutes) values (p_user, '2026-11-02', 480) returning id into v_plan;
  insert into public.plan_slots (plan_id, user_id, day, session_type, planned_min, context) values (v_plan, p_user, '2026-11-03', 'micro', 20, 'phone');
  insert into public.sessions (user_id, session_type, context, planned_min, available_minutes) values (p_user, 'micro', 'phone', 10, 10) returning id into v_session;
  insert into public.session_tasks (session_id, position, task_kind, skill_key, user_id, item_id) values (v_session, 1, 'retrieval', 'math.rlstest.pub', p_user, v_item);
  insert into public.user_projects (user_id, project_key) values (p_user, 'prj.L0.rlstest') returning id into v_up;
  insert into public.evidence_challenges (user_id, user_project_id, step_key, code, expires_at)
    values (p_user, v_up, 'prj.L0.rlstest#s01', 'PM-' || p_tag, now() + interval '1 day') returning id into v_ch;
  insert into public.project_evidence (user_project_id, user_id, step_key, evidence_kind, content, challenge_id)
    values (v_up, p_user, 'prj.L0.rlstest#s01', 'note', '{}', v_ch);
  insert into public.project_grants (user_id, user_project_id, project_key, skill_key, tier, status)
    values (p_user, v_up, 'prj.L0.rlstest', 'math.rlstest.pub', 'L1', 'pending');
  insert into public.tutor_threads (user_id) values (p_user) returning id into v_thread;
  insert into public.tutor_messages (thread_id, role, content, user_id) values (v_thread, 'assistant', 'hello', p_user) returning id into v_msg;
  insert into public.checkpoints (user_id, scope_node, reason) values (p_user, 'math', 'manual');
  insert into public.events (user_id, name) values (p_user, 'rlstest.seen');
  insert into public.push_subscriptions (user_id, endpoint, p256dh, auth) values (p_user, 'https://push.example.test/' || p_tag, 'k', 'a');
  insert into public.privacy_requests (user_id, kind) values (p_user, 'export');
  insert into public.experiment_assignments (experiment_key, user_id, arm, unit_type, unit_key, block_index, rng_seed)
    values ('exp.rlstest', p_user, 'control', 'user', p_user::text, 0, 'seed');
  insert into public.item_reports (user_id, item_id, reason) values (p_user, v_item, 'ambiguous');
  insert into public.llm_calls (user_id, purpose, provider, model, prompt_version) values (p_user, 'tutor', 'fake', 'fake', 'rls-test');
end $$;
select rls_test.seed_user(rls_test.user_a(), '2AAA-2AAA', 1);
select rls_test.seed_user(rls_test.user_b(), '2BBB-2BBB', 2);

-- Mutation hook for tools/rls-mutation.sh: `psql -v rls_mutation=<name>` breaks attempts' protection
-- INSIDE this transaction (rolled back with it), to prove the ST-RLS checks can fail. Never set by
-- pnpm test:rls / pg_prove, so the \if branch is skipped there.
\if :{?rls_mutation}
  select :'rls_mutation' = 'disable_rls' as m_disable, :'rls_mutation' = 'open_policy' as m_open \gset
  \if :m_disable
    alter table public.attempts disable row level security;
  \endif
  \if :m_open
    drop policy attempts_select_own on public.attempts;
    create policy attempts_select_own on public.attempts for select to authenticated using (true);
  \endif
\endif

-- Admin-only tables: one job and one content sync run, both tagged so they are recognisable.
select public.enqueue_job('content_postprocess', '{"t":"rlstest"}'::jsonb, null, 'rlstest-dedupe');
insert into public.content_sync_runs (git_sha) values ('rlstest');

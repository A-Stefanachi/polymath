-- BL-0011: shared harness for the RLS tests (doc 12 section 13.2). NOT a test: pg_prove only runs
-- *.sql files, so every test includes this file with `\ir _helpers.psql` right after `begin;`.
--
-- Everything happens inside the caller's transaction and the test ends with `rollback`, so the shared
-- local database is left exactly as found (other agents use it at the same time). Fixture ids are
-- unique to this suite: users 0000a011-..., skills math.rlstest.*, module math.rlstest.
--
-- Usage in a test:
--   select rls_test.act_as(rls_test.user_a());   -- role authenticated, JWT sub = A
--   select is((select count(*) from public.profiles where id = rls_test.user_b()), 0::bigint, '...');
--   reset role;
--   select rls_test.act_as_anon();               -- role anon, no JWT
-- Helper functions stay callable after a role switch because the schema grants usage to PUBLIC.

create extension if not exists pgtap with schema extensions;
set search_path = public, extensions;

create schema rls_test;
grant usage on schema rls_test to public;

create function rls_test.user_a() returns uuid language sql immutable as $$ select '0000a011-0000-4000-8000-00000000000a'::uuid $$;
create function rls_test.user_b() returns uuid language sql immutable as $$ select '0000a011-0000-4000-8000-00000000000b'::uuid $$;
create function rls_test.user_c() returns uuid language sql immutable as $$ select '0000a011-0000-4000-8000-00000000000c'::uuid $$;  -- admin
grant execute on all functions in schema rls_test to public;

-- Run the following statements as `authenticated` with the JWT claims PostgREST would set. Both the
-- JSON form (request.jwt.claims) and the legacy single-claim form are set, so auth.uid() works either way.
-- `set local role` inside a plpgsql function lasts until the end of the transaction or `reset role`.
create function rls_test.act_as(p_user uuid) returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', p_user, 'role', 'authenticated')::text, true);
  perform set_config('request.jwt.claim.sub', p_user::text, true);
  perform set_config('request.jwt.claim.role', 'authenticated', true);
  set local role authenticated;
end $$;

create function rls_test.act_as_anon() returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  perform set_config('request.jwt.claim.sub', '', true);
  perform set_config('request.jwt.claim.role', 'anon', true);
  set local role anon;
end $$;

create function rls_test.act_as_service() returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'service_role')::text, true);
  perform set_config('request.jwt.claim.sub', '', true);
  perform set_config('request.jwt.claim.role', 'service_role', true);
  set local role service_role;
end $$;

-- Tables that carry one row per learner in the fixture, with the column holding the owner id.
create table rls_test.owned_tables (tbl text primary key, owner_col text not null);
insert into rls_test.owned_tables values
  ('profiles', 'id'), ('weekly_plans', 'user_id'), ('plan_slots', 'user_id'), ('sessions', 'user_id'),
  ('session_tasks', 'user_id'), ('attempts', 'user_id'), ('skill_state', 'user_id'), ('review_log', 'user_id'),
  ('user_projects', 'user_id'), ('project_evidence', 'user_id'), ('evidence_challenges', 'user_id'),
  ('project_grants', 'user_id'), ('tutor_threads', 'user_id'), ('tutor_messages', 'user_id'),
  ('checkpoints', 'user_id'), ('events', 'user_id'), ('push_subscriptions', 'user_id'),
  ('privacy_requests', 'user_id'), ('experiment_assignments', 'user_id'), ('item_reports', 'user_id'),
  ('llm_calls', 'user_id'), ('items', 'user_id');
grant select on rls_test.owned_tables to public;

-- Row counts the current role sees per owned table: rows of p_me, rows of p_other (an explicit
-- `where owner = other`), and rows of anybody else. Runs with the caller's privileges (not definer).
create function rls_test.counts(p_me uuid, p_other uuid)
returns table (tbl text, own bigint, other bigint, foreign_rows bigint) language plpgsql as $$
declare r record;
begin
  for r in select o.tbl as t, o.owner_col as c from rls_test.owned_tables o order by 1 loop
    tbl := r.t;
    execute format('select count(*) from public.%1$I where %2$I = $1', r.t, r.c) into own using p_me;
    execute format('select count(*) from public.%1$I where %2$I = $1', r.t, r.c) into other using p_other;
    execute format('select count(*) from public.%1$I where %2$I is not null and %2$I <> $1', r.t, r.c) into foreign_rows using p_me;
    return next;
  end loop;
end $$;

-- SQLSTATE a statement fails with, or 'none' when it succeeds (errors are caught, not swallowed: the
-- caller asserts on the returned code). Used where a loop over many statements needs one assertion.
create function rls_test.sqlstate_of(p_sql text) returns text language plpgsql as $$
begin
  execute p_sql;
  return 'none';
exception when others then
  return sqlstate;
end $$;

-- Operations on a table that the current role is NOT refused with 42501 (empty string = all denied).
create function rls_test.writes_not_denied(p_tbl text) returns text language plpgsql as $$
declare v_col text; v_ops text[]; v_op text; v_out text := '';
begin
  select attname into v_col from pg_attribute
   where attrelid = ('public.' || quote_ident(p_tbl))::regclass and attnum > 0 and not attisdropped order by attnum limit 1;
  v_ops := array[
    format('insert into public.%I default values', p_tbl),
    format('update public.%I set %I = %I', p_tbl, v_col, v_col),
    format('delete from public.%I', p_tbl)];
  foreach v_op in array v_ops loop
    if rls_test.sqlstate_of(v_op) <> '42501' then v_out := v_out || p_tbl || ': ' || split_part(v_op, ' ', 1) || '; '; end if;
  end loop;
  return v_out;
end $$;

-- Tables of schema p_schema the current role can read at least one statement from (should be none for anon).
create function rls_test.readable_tables(p_schema text) returns text language plpgsql as $$
declare r record; v_out text := '';
begin
  for r in select c.relname from pg_class c where c.relnamespace = p_schema::regnamespace and c.relkind in ('r', 'p', 'v') order by 1 loop
    if rls_test.sqlstate_of(format('select 1 from %I.%I limit 1', p_schema, r.relname)) <> '42501' then
      v_out := v_out || r.relname || '; ';
    end if;
  end loop;
  return v_out;
end $$;
grant execute on all functions in schema rls_test to public;

-- ST-RLS-01 allow-list: public/app_private tables allowed to have RLS disabled, each with a reason.
create table rls_test.no_rls_allowed (tbl text primary key, reason text not null);
grant select on rls_test.no_rls_allowed to public;
\ir no-rls-allowlist.psql

-- ---------------------------------------------------------------------------------------------
-- Fixture (as the migration/superuser role): users A, B, admin C, one content tree, and one row of
-- every user-owned table for A and for B.
-- ---------------------------------------------------------------------------------------------
insert into auth.users (id, email) values
  (rls_test.user_a(), 'rls-a@example.test'),
  (rls_test.user_b(), 'rls-b@example.test'),
  (rls_test.user_c(), 'rls-c@example.test');          -- the on_auth_user_created trigger adds the profiles
insert into public.admin_users (user_id) values (rls_test.user_c());

insert into public.modules (key, node, module, title, order_index) values ('math.rlstest', 'math', 'rlstest', 'RLS test module', 0);
insert into public.skills (key, node, module, title, tier_target, est_minutes, license, source, status, task_kinds, grader_types) values
  ('math.rlstest.pub',   'math', 'rlstest', 'verified skill', 'L1', 5, 'original', 'rls-test', 'verified', '{worked_example,retrieval}', '{exact_numeric}'),
  ('math.rlstest.draft', 'math', 'rlstest', 'draft skill',    'L1', 5, 'original', 'rls-test', 'draft',    '{worked_example,retrieval}', '{exact_numeric}');
insert into public.item_templates (key, skill_key, task_kind, grader_type, version, status, body, license, source) values
  ('tpl.math.rlstest-t', 'math.rlstest.pub', 'problem', 'exact_numeric', 1, 'verified', '{"secret":"generator"}', 'original', 'rls-test');
insert into public.projects (key, title, ladder_level, est_hours, status, license, source, spec)
  values ('prj.L0.rlstest', 'RLS test project', 0, 1, 'verified', 'original', 'rls-test', '{"expected":"hidden"}');
insert into public.project_steps (key, project_key, position, title, est_min, session_type, verification_spec)
  values ('prj.L0.rlstest#s01', 'prj.L0.rlstest', 1, 'step', 60, 'focus', '{"expected":"hidden"}');
insert into public.experiments (key, description, started_at, status, allocation_treatment_pct, design) values
  ('exp.rlstest', 'running, user level', now() - interval '1 day', 'running', 50, '{}'),

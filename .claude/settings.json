{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "bashOutputMaxChars": 12000,
  "autoCompactWindow": 250000,
  "extraKnownMarketplaces": {
    "autoswe": {
      "source": {
        "source": "github",
        "repo": "a-stefanachi/claude-autonomous-swe"
      }
    }
  },
  "enabledPlugins": {
    "autoswe@autoswe": true
  },
  "permissions": {
    "allow": [
      "Bash(bash .autoswe/gates.sh)",
      "Bash(FAST=1 bash .autoswe/gates.sh)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files *)",
      "Bash(git push -u origin feat/*)",
      "Bash(autoswe-index *)",
      "Bash(autoswe-tasks status *)",
      "Bash(autoswe-tasks next *)",
      "Bash(autoswe-tasks validate *)",
      "Bash(autoswe-tasks state *)",
      "Bash(autoswe-tasks active *)",
      "Bash(autoswe-tasks brief *)",
      "Bash(autoswe-tasks evidence *)",
      "Bash(autoswe-tasks spec-check *)",
      "Bash(autoswe-tasks review *)",
      "Bash(autoswe-mutate *)",
      "Bash(autoswe-toolchain list *)",
      "Bash(autoswe-toolchain scan *)",
      "Bash(autoswe-toolchain outdated)",
      "Bash(autoswe-usage)",
      "Bash(autoswe-usage *)",
      "Bash(autoswe-toolchain check *)",
      "Bash(AUTOSWE_GATE_SCOPE=changed bash .autoswe/gates.sh)",
      "Bash(AUTOSWE_GATE_CACHE=0 bash .autoswe/gates.sh)",
      "Bash(pnpm -w lint)",
      "Bash(pnpm -w typecheck)",
      "Bash(pnpm -w test)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm --filter * test)",
      "Bash(pnpm claims:lint)",
      "Bash(pnpm lint:boundaries)",
      "Bash(bash tools/ci/spec-validators.sh)",
      "Bash(python3 -B polymath-app-spec/reference/*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!.env.example)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify *)"
    ]
  },
  "env": {
    "AUTOSWE_PROTECTED_BRANCHES": "main master",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "8",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  }
}
